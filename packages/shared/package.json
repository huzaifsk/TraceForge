{
  "name": "@pulseed/shared",
  "version": "0.1.0",
  "description": "Isomorphic, dependency-free helpers shared by the Pulseed SDK, API and dashboard.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@pulseed/event-schema": "workspace:*"
  },
  "devDependencies": {
    "@pulseed/eslint-config": "workspace:*",
    "@pulseed/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  }
}
