{
  "name": "@traceforge/event-schema",
  "version": "0.1.0",
  "description": "Wire-format contract (Zod schemas + TypeScript types) for TraceForge monitoring events.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@traceforge/eslint-config": "workspace:*",
    "@traceforge/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  }
}
