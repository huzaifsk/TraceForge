{
  "name": "@traceforge/sdk",
  "version": "0.2.1",
  "description": "Lightweight browser SDK for TraceForge: JS errors, API failures, Web Vitals and navigation \u2014 batched, retried and privacy-first.",
  "keywords": [
    "observability",
    "monitoring",
    "error-tracking",
    "web-vitals",
    "rum",
    "performance",
    "react",
    "nextjs"
  ],
  "homepage": "https://github.com/huzaifsk/TraceForge#readme",
  "bugs": {
    "url": "https://github.com/huzaifsk/TraceForge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huzaifsk/TraceForge.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "author": "Huzaif S (https://github.com/huzaifsk)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/traceforge.iife.js",
  "jsdelivr": "./dist/traceforge.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@traceforge/eslint-config": "workspace:*",
    "@traceforge/event-schema": "workspace:*",
    "@traceforge/shared": "workspace:*",
    "@traceforge/typescript-config": "workspace:*",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "^20.14.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "^14.0.0",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:",
    "web-vitals": "^6.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": "full SDK: init + all integrations + web-vitals (ESM, min+brotli)",
      "path": "dist/index.js",
      "import": "{ init }",
      "limit": "10 KB"
    },
    {
      "name": "React error boundary, beyond core (ESM, min+brotli)",
      "path": "dist/react.js",
      "import": "{ TraceForgeErrorBoundary }",
      "limit": "1 KB"
    },
    {
      "name": "Next.js server error capture, beyond core (ESM, min+brotli)",
      "path": "dist/next.js",
      "import": "{ withTraceForge }",
      "limit": "1 KB"
    }
  ]
}
