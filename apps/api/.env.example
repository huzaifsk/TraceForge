# Copy to apps/api/.env for local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Postgres — `pnpm db:up` starts this locally. For production use Neon/Supabase.
DATABASE_URL=postgres://traceforge:traceforge@localhost:5432/traceforge

# Public base URL of this API (used to build project DSNs and by the auth library).
PUBLIC_API_URL=http://localhost:4000

# Session signing secret, at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-random-32-plus-character-secret

# Comma-separated origins allowed to call the dashboard (query) API with credentials.
DASHBOARD_ORIGINS=http://localhost:3000

# Ingestion rate limit per project key, per minute.
INGEST_RATE_LIMIT_PER_MINUTE=600

# Apply database migrations when the server starts (set true on hosts without a pre-deploy step).
MIGRATE_ON_START=false
